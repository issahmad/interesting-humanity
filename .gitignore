# macOS
.DS_Store

# Large generated media (kept out of git)
videos/*/images/*
videos/*/audio/*
!videos/*/images/.gitkeep
!videos/*/audio/.gitkeep

# Renders
*.mp4
*.mov
*.webm
renders/
out/

# Node / Remotion
node_modules/
.remotion/

# Env / secrets
.env
.env.*
!.env.example

# Local Whisper build + models
tools/transcribe/whisper.cpp/

# Raw Whisper output (words.json is the aligned version)
videos/*/whisper_words.json
videos/*/timeline.json
